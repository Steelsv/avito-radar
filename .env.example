# Avito Radar - переменные окружения

# Токен Telegram-бота от @BotFather (обязателен для работы бота)
TELEGRAM_BOT_TOKEN=

# Telegram chat_id супер-владельца: всегда считается PRO
TELEGRAM_CHAT_ID=

# Публичный URL Mini App (для кнопок web_app и return_url оплат)
MINI_APP_URL=

# Порт HTTP-сервера (healthcheck + API для Mini App)
PORT=7860

# Включить long polling Telegram (true/false)
ENABLE_TG_POLLING=true

# URL git-репозитория для синхронизации data/ (опционально)
DATA_REPO_URL=

# ЮKassa: оплата по карте/СБП. Пусто - фронт скрывает кнопку оплаты ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
